# Generated/build state
**/.gradle/
**/build/
**/run/
**/runs/
**/out/
**/.idea/
**/*.iml
**/.classpath
**/.project
**/.settings/

# Dynamically acquired upstream references/toolchains/caches
.reference-cache/
reference-cache/
.native-cache/
.toolchain-cache/

# Never vendor resolved third-party/game/runtime binaries.
# The redistribution guard enforces this against tracked files as well.
*.jar
*.class
*.zip
*.7z
*.rar
*.tgz
*.tar.gz
*.dll
*.so
*.dylib
*.exe
*.msi
*.part-*

# Diagnostics/profilers
**/*.hprof
**/*.jfr
**/hs_err_pid*
**/replay_pid*

# OS/editor
.DS_Store
Thumbs.db
*.swp
*.tmp

# Local secrets/config
.env
.env.*
!.env.example
secrets/
**/secrets.*
**/local.properties
**/gradle-local.properties
