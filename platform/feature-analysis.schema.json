{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridelyx.dev/schema/feature-analysis.schema.json",
  "schema_version": 1,
  "title": "Gridelyx Feature Decision Packet",
  "type": "object",
  "required": [
    "feature_id",
    "title",
    "cr_ids",
    "kanban_state",
    "targets",
    "desired_outcome",
    "w5x5x5",
    "values",
    "first_principles",
    "task_breakdown",
    "benchmarks",
    "tradeoffs",
    "cost",
    "time_horizons",
    "opportunity_cost",
    "regret_minimisation",
    "reversibility",
    "risks",
    "inversion",
    "second_order_effects",
    "eisenhower",
    "overlaps",
    "mvp",
    "timebox",
    "premortem",
    "asymmetric_risk",
    "pareto",
    "critical_path",
    "cynefin",
    "validation",
    "rollback"
  ],
  "properties": {
    "feature_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "cr_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^CR-[0-9]{3}$"}},
    "kanban_state": {"enum": ["backlog", "ready", "doing", "blocked", "verifying", "done"]},
    "targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "desired_outcome": {"type": "string", "minLength": 1},
    "w5x5x5": {
      "type": "object",
      "required": ["who", "who_not", "what", "what_isnt", "when", "when_isnt", "where", "where_isnt", "how", "how_not", "why", "why_isnt"],
      "properties": {
        "who": {"$ref": "#/$defs/fivePasses"},
        "who_not": {"$ref": "#/$defs/fivePasses"},
        "what": {"$ref": "#/$defs/fivePasses"},
        "what_isnt": {"$ref": "#/$defs/fivePasses"},
        "when": {"$ref": "#/$defs/fivePasses"},
        "when_isnt": {"$ref": "#/$defs/fivePasses"},
        "where": {"$ref": "#/$defs/fivePasses"},
        "where_isnt": {"$ref": "#/$defs/fivePasses"},
        "how": {"$ref": "#/$defs/fivePasses"},
        "how_not": {"$ref": "#/$defs/fivePasses"},
        "why": {"$ref": "#/$defs/fivePasses"},
        "why_isnt": {"$ref": "#/$defs/fivePasses"}
      },
      "additionalProperties": false
    },
    "values": {"type": "object"},
    "first_principles": {"type": "object"},
    "task_breakdown": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "benchmarks": {"type": "array", "items": {"type": "object"}},
    "tradeoffs": {"type": "object"},
    "cost": {"type": "object"},
    "time_horizons": {
      "type": "object",
      "required": ["10_minutes", "10_hours", "10_days", "10_months", "1_year", "5_years", "10_years"],
      "additionalProperties": true
    },
    "opportunity_cost": {"type": "object"},
    "regret_minimisation": {"type": "object"},
    "reversibility": {"type": "object"},
    "risks": {"type": "array", "items": {"type": "object"}},
    "inversion": {"type": "object"},
    "second_order_effects": {"type": "array", "items": {"type": "string"}},
    "eisenhower": {"type": "object"},
    "overlaps": {"type": "object"},
    "mvp": {"type": "object"},
    "timebox": {"type": "object"},
    "premortem": {"type": "object"},
    "asymmetric_risk": {"type": "object"},
    "pareto": {"type": "object"},
    "critical_path": {"type": "object"},
    "cynefin": {"type": "object"},
    "validation": {"type": "object"},
    "rollback": {"type": "object"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "decision": {"type": "string"}
  },
  "$defs": {
    "fivePasses": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
