{
  "schema_version": 1,
  "purpose": "Machine-readable source-of-truth map for humans and AI systems that need the same mod-development reference surface as a locally vendored SDK without committing upstream payloads.",
  "policy": {
    "repository_storage": "metadata-and-project-owned-source-only",
    "hydrated_root": ".reference-cache/corpus",
    "index_root": ".reference-cache/index",
    "official_or_authorized_sources_only": true,
    "pin_when_possible": true,
    "generated_minecraft_source_is_local_only": true,
    "do_not_train_or_publish_from_material_without_licence_review": true,
    "source_priority": [
      "repository-pinned configuration and Gridelyx code",
      "pinned official MDK/template",
      "official NeoForged documentation",
      "official project source repositories",
      "resolved source/Javadoc artifacts from package repositories",
      "locally generated Minecraft development sources under applicable Mojang terms"
    ]
  },
  "references": [
    {
      "id": "gridelyx-template",
      "kind": "project-source",
      "version": "26.2",
      "location": "templates/neoforge-26.2",
      "roles": ["canonical-build", "mod-bootstrap", "datagen", "resources", "advanced-runtime"],
      "ai_priority": 100,
      "repository_storage": "tracked-project-owned-source"
    },
    {
      "id": "neoforge-mdk-26.2-moddevgradle",
      "kind": "git-source-template",
      "version": "26.2",
      "source_url": "https://github.com/NeoForgeMDKs/MDK-26.2-ModDevGradle.git",
      "revision": "3a29a9e13f09e27050c0dd962b365a070fae990b",
      "local_destination": ".reference-cache/corpus/neoforge-mdk-26.2",
      "roles": ["canonical-upstream-template", "gradle-layout", "mod-metadata", "examplemod", "datagen-layout"],
      "ai_priority": 95,
      "repository_storage": "prohibited",
      "licence_rule": "Read upstream TEMPLATE_LICENSE.txt and file notices before redistribution; local reference checkout only by Gridelyx policy."
    },
    {
      "id": "neoforge-documentation",
      "kind": "documentation",
      "version": "current-for-target",
      "docs_url": "https://docs.neoforged.net/",
      "source_url": "https://github.com/neoforged/Documentation.git",
      "local_destination": ".reference-cache/corpus/neoforge-documentation",
      "roles": ["registries", "events", "networking", "datagen", "worldgen", "rendering", "mod-files", "toolchain", "porting"],
      "ai_priority": 100,
      "repository_storage": "prohibited",
      "licence": "MIT"
    },
    {
      "id": "moddevgradle",
      "kind": "toolchain-source-and-docs",
      "version": "2.0.144",
