      "source_url": "https://github.com/neoforged/ModDevGradle.git",
      "local_destination": ".reference-cache/corpus/moddevgradle",
      "roles": ["dependency-resolution", "minecraft-development-runtime", "runs", "mappings", "ide-integration"],
      "ai_priority": 95,
      "repository_storage": "prohibited",
      "licence_rule": "Use upstream repository licence and notices as authoritative."
    },
    {
      "id": "neoforge-source",
      "kind": "api-source",
      "version": "26.2.0.67",
      "source_url": "https://github.com/neoforged/NeoForge.git",
      "branch_hint": "26.2.x",
      "maven_repository": "https://maven.neoforged.net/releases/",
      "coordinate": "net.neoforged:neoforge:26.2.0.67",
      "local_destination": ".reference-cache/corpus/neoforge-source",
      "roles": ["api-implementation", "events", "registries", "network", "server", "client", "patch-behaviour"],
      "ai_priority": 90,
      "repository_storage": "prohibited",
      "licence": "LGPL-2.1"
    },
    {
      "id": "minecraft-version-metadata",
      "kind": "official-metadata",
      "version": "dynamic",
      "metadata_url": "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json",
      "roles": ["version-resolution", "libraries", "assets", "runtime-metadata", "launch-metadata"],
      "ai_priority": 70,
      "repository_storage": "metadata-link-only"
    },
    {
      "id": "minecraft-development-sources",
      "kind": "generated-local-reference",
      "version": "26.2",
      "producer": "NeoForge ModDevGradle using the configured Minecraft/NeoForge target and official mapping names",
      "mapping_licence_reference": "https://github.com/NeoForged/NeoForm/blob/main/Mojang.md",
      "local_discovery": [
        "Gradle/ModDevGradle generated sources attached to the IDE",
        "Gradle user-home caches for the resolved development environment"
      ],
      "roles": ["minecraft-types", "method-signatures", "field-signatures", "vanilla-behaviour-reference"],
      "ai_priority": 85,
      "repository_storage": "strictly-prohibited",
      "licence_rule": "Local development/reference use only under the applicable Minecraft EULA and Mojang mapping licence; do not commit, mirror, publish or treat generated/decompiled Minecraft source as Gridelyx-owned source."
    },
