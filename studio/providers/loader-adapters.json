    {"id":"quilt","status":"builtin","source":"quilt-meta","strategy":"official_profile_json"},
    {"id":"forge","status":"builtin","source":"forge-official","strategy":"official_installer_or_profile_materialization"},
    {"id":"neoforge","status":"builtin","source":"neoforge-maven","strategy":"official_installer_or_profile_materialization"},
    {"id":"legacy-launcher-profile","status":"extensible","source":"local-import","strategy":"user_supplied_profile_with_hash_and_provenance"},
    {"id":"external-adapter","status":"plugin-contract","source":"provider-defined","strategy":"signed_adapter_manifest"}
  ]
}
