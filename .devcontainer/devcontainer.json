{
  "name": "Minecraft Advanced Mod R&D",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": "false",
      "installGradle": "false"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "python3 tools/validate_platform.py && chmod +x templates/neoforge-26.2/gradlew",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vscjava.vscode-gradle",
        "github.copilot",
        "github.copilot-chat",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "remoteUser": "vscode"
}
